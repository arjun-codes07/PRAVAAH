# ============================================================
# PRAVAAH Frontend — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# Backend API base URL (include /api/v1 path)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Polling interval in milliseconds
VITE_POLL_INTERVAL_MS=15000

# MapTiler API Key for vector base maps (DataViz Dark, Topographic Terrain, Satellite Hybrid)
# Get a free key at https://cloud.maptiler.com/account/keys/
VITE_MAPTILER_API_KEY=
