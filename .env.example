# ============================================================
# PRAVAAH Backend — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# === PostgreSQL Connection ===
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/pravaah

# === Application Role (least-privilege) ===
PRAVAAH_APP_USER=pravaah_app
PRAVAAH_APP_PASSWORD=

# === Seed Script Passwords (bcrypt-hashed before storage) ===
SEED_PASSWORD_OFFICER=
SEED_PASSWORD_COMMANDER=
SEED_PASSWORD_COORDINATOR=

# === FastAPI Security & API Configuration ===
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
STALE_DEFAULT_MINUTES=60

# === Risk Engine (Phase 3) ===
RISK_MODEL_VERSION=0.2-demo
RISK_HORIZON_MINUTES=360

# === Simulator Credentials (Phase 4) ===
SIMULATOR_EMAIL=officer@demo.pravaah.local
SIMULATOR_PASSWORD=
